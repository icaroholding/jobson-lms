# ============================================================
# Jobson Academy — Production environment
# Copia questo file in `.env` e compila tutti i valori.
# NON committare mai `.env` nel repository.
# ============================================================

# Dominio pubblico (deve puntare all'IP del server con un record A)
DOMAIN=learn.jobsonai.com

# Email per notifiche Let's Encrypt (scadenza certificato, problemi SSL)
LETSENCRYPT_EMAIL=admin@jobsonai.com

# Nome del site Frappe (tipicamente uguale al dominio)
SITE_NAME=learn.jobsonai.com

# Password root MariaDB — genera una stringa lunga e casuale
# Suggerimento: openssl rand -base64 32
DB_ROOT_PASSWORD=CHANGE_ME_mariadb_root_password

# Password Administrator Frappe — usata per il primo login dopo il deploy
# Accesso: https://$DOMAIN/login  —  utente: Administrator
ADMIN_PASSWORD=CHANGE_ME_admin_password

# Fork del LMS da installare (non toccare se non sai cosa fai)
LMS_REPO=https://github.com/icaroholding/jobson-lms
LMS_BRANCH=develop
